@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant "System" as System

activate Employee

    Employee -> System : asks to upgrade a station
    activate System

        System --> Employee : shows available stations
    deactivate System

    Employee -> System : selects a station
    activate System

        System --> Employee : receives the chosen station and shows available buildings
    deactivate System

    Employee -> System : chooses the building
    activate System

        System --> Employee : receives the chosen building and shows its upgrade and cost
    deactivate System

    Employee -> System : accepts and pays the cost
    activate System

        System --> Employee : builds the building and applies the upgrade \n on the chosen station, and displays operation success
    deactivate System
@enduml