@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction


class CreateMapUI {

}

class CreateMapController {
  +getMap()
  +createMap(size, name)
}

class MapRepository {
   +getMapRepository()
}

class Repositories {
    - Repositories()
    + getInstance()
    + getMapRepository()
}

class Map {
  - size : int
  - name : String
  + Map(size, name)

}

CreateMapUI ..> CreateMapController
CreateMapController ..> Repositories
CreateMapController ..> MapRepository
CreateMapController ..> Map
MapRepository --> "*" Map : map
Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance


@enduml