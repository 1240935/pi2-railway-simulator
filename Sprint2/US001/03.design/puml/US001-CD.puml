@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction


class CreateMapUI {

}

class CreateMapController {
  +createMap(size, name)
}

class MapRepository {
   +getMap()
}

class Repositories {
    - Repositories()
    + {static} getInstance()
    + getMapRepository()
}

class Map {
  - size : int
  - name : String
  + Map(size, name)

}

CreateMapUI ..> CreateMapController
CreateMapController .> Repositories
CreateMapController ..> MapRepository
CreateMapController ..> Map
MapRepository --> "1" Map : map
Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance


@enduml