@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox
actor "Editor" as EDITOR
participant ":CreateMapUI" as UI
participant ":CreateMapController" as CTRL
participant ":MapRepository" as MAP_REPO
participant "Map" as MAP

activate EDITOR

    EDITOR -> UI : asks to create a map
    activate UI

        UI --> EDITOR : asks for a size and a name
    deactivate UI

    EDITOR -> UI : types a size and a name
    activate UI

        UI --> EDITOR : displays the data and asks for confirmation
    deactivate UI

    EDITOR -> UI : confirms data
    activate UI

        UI -> CTRL : createMap(size, name)
        activate CTRL

            CTRL -> MAP_REPO : checkMapNameExists(name)
            activate MAP_REPO

                ref over MAP_REPO
                    Check if name already exists
                end ref

                MAP_REPO --> CTRL : false
            deactivate MAP_REPO

            CTRL -> MAP : create(size, name)
            activate MAP

                ref over MAP
                    Create map object
                end ref

                MAP --> CTRL : map
            deactivate MAP

            CTRL -> MAP_REPO : save(map)
            activate MAP_REPO

                ref over MAP_REPO
                    Save map object
                end ref

                MAP_REPO --> CTRL : success
            deactivate MAP_REPO

            CTRL --> UI : success
        deactivate CTRL

        UI --> EDITOR : displays operation success
    deactivate UI

deactivate EDITOR

@enduml
