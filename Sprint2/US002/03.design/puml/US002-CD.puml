@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

  class CreateIndustryUI{
  }

  class CreateIndustryController {
    +CreateIndustryController()
    +getAvailableMaps()
    +setMapByIndex(index)
    +getAvailableIndustryTypeNames()
    +checkCoordinates(xCoordinate, yCoordinate)
    +setIndustryTypeByIndex(index)
    +createIndustry(type, position, resourceType)
    +setType(type)
  }


  class Repositories {
      - Repositories()
      + getInstance()
      + getMapRepository()
  }
  class MapRepository {
    +getMaps()
  }

  class Industry {
    -position : Position
    -type : IndustryType
    +Industry(position, type)
  }
  class Map {
    - size : int
    - name : String
    - industries : List<Industry>
    - cities : List<City>
    + Map(name, size)
    +checkCoordinates(position)
    }

  class Position {
    -xCoordinate : int
    -yCoordinate : int
    +Position(xCoordinate, yCoordinate)
  }

  enum IndustryType{
    aluminum mill
    auto plant
    bakery
    bauxit mine
    cannery
    cattle yard
    chemical plant
    cement plant
    coal mine
    coffee farm
    cotton farm
    dairy farm
    dairy processor
    electric plant
    fertilizer plant
    grain silo
    gravel pit
    iron mine
    landfill
    logging camp
    lumber mill
    meat packing plant
    nuclear plant
    oil refinery
    oil well
    paper mill
    produce orchard
    rubber farm
    steel mill
    textile mill
    tire factory
    tool and die factory
    uranium mine
    geocore plant
    distillery
    munitions factory
    weapons factory
    port
  }




CreateIndustryUI ..> CreateIndustryController
CreateIndustryController ..>  Repositories
CreateIndustryController ..>  MapRepository
CreateIndustryController ..>  Map
CreateIndustryController ..> Position
CreateIndustryController ..> IndustryType
CreateIndustryController ..> Industry
Repositories --> "1" MapRepository : map repository
Repositories -> "1" Repositories : instance
MapRepository --> "*" Map : map
Industry --> "1" Position : position
IndustryType --> "1" Industry : industry type

@enduml