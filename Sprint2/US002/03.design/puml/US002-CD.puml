@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

  class CreateIndustryUI

  class CreateIndustryController {
    +getAvailableMaps()
    +setMap(map: Map)
    +createPosition(x: int, y: int): Position
    +checkCoordinates(pos: Position): boolean
    +getAvailableIndustriesTypes(): List<IndustryType>
    +setType(type: IndustryType)
    +getAvailableResourceTypes(): List<ResourceType>
    +setReosurceType(resourceType: ResourceType)
    +createIndustry(type: IndustryType, pos: Position, resType: ResourceType): Industry
  }


  class Repositories {
    +getInstance(): Repositories
  }
  class MapRepository {
    +getMaps(): List<Map>
  }

  class Industry {
    +Industry(pos: Position, type: IndustryType, resourceType: ResourceType)
  }

  class Map {
    +checkCoordinates(pos: Position): boolean
  }

  class Position {
    +Position(x: int, y: int)
  }

  enum IndustryType
  enum ResourceType


CreateIndustryUI ..> CreateIndustryController
CreateIndustryController ..>  Repositories
CreateIndustryController ..>  MapRepository
CreateIndustryController ..>  Map
CreateIndustryController ..> Position
CreateIndustryController ..> IndustryType
CreateIndustryController ..> ResourceType
CreateIndustryController ..> Industry
MapRepository --> "*" Map : map
Industry --> "1" Position : position
Industry --> "1" IndustryType : industry type
Industry --> "1" ResourceType : resource type

@enduml