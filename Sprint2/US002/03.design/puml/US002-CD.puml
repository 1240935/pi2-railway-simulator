@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

  class CreateIndustryUI{
  }

  class CreateIndustryController {
    +CreateIndustryController()
    +getAvailableMaps()
    +setMap(map)
    +createPosition(xCoordinate, yCoordinate
    +checkCoordinates(position)
    +getAvailableIndustriesTypes()
    +setType(type)
    +getAvailableResourceTypes()
    +setResourceType(resourceType)
    +createIndustry(type, position, resourceType)
  }


  class Repositories {
      - Repositories()
      + getInstance()
      + getMapRepository()
  }
  class MapRepository {
    +getMaps()
  }

  class Industry {
    -position : Position
    -type : IndustryType
    -resourceType: ResourceType
    +Industry(position, type, resourceType)
  }

  class Map {
    - size : int
    - name : String
    +checkCoordinates(position)
  }

  class Position {
    -xCoordinate : int
    -yCoordinate : int
    +Position(xCoordinate, yCoordinate)
  }

  enum IndustryType{
    Primary Sector
    Transforming
    Mixed
  }

  enum ResourceType{
    Iron
    Coal
    Bauxite
    Nitrate Mines
    Vegetables
    Cereals
    Wool
    Coffee
    Rubber
    Cattle
    Bakery
    Textile
    Automobile
    Steel Mill
  }


CreateIndustryUI ..> CreateIndustryController
CreateIndustryController ..>  Repositories
CreateIndustryController ..>  MapRepository
CreateIndustryController ..>  Map
CreateIndustryController ..> Position
CreateIndustryController ..> IndustryType
CreateIndustryController ..> ResourceType
CreateIndustryController ..> Industry
Repositories --> "1" MapRepository : map repository
Repositories -> "1" Repositories : instance
MapRepository --> "*" Map : map
Industry --> "1" Position : position
IndustryType --> "1" Industry : industry type
ResourceType --> "1" Industry : resource type

@enduml