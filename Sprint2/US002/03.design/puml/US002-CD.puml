@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

  class CreateIndustryUI{
  }

  class CreateIndustryController {
    +CreateIndustryController()
    +getAvailableMaps()
    +setMap(map: Map)
    +createPosition(xCoordinate: int, yCoordinate: int): Position
    +checkCoordinates(pos: Position): boolean
    +getAvailableIndustriesTypes(): List<IndustryType>
    +setType(type: IndustryType)
    +getAvailableResourceTypes(): List<ResourceType>
    +setReosurceType(resourceType: ResourceType)
    +createIndustry(type: IndustryType, position: Position, resourceType: ResourceTypeType): Industry
  }


  class Repositories {
      - Repositories()
      + getInstance()
      + getMapRepository()
  }
  class MapRepository {
    +getMaps(): List<Map>
  }

  class Industry {
    -position : Position
    -type : IndustryType
    -resourceType: ResourceType
    +Industry(position: Position, type: IndustryType, resourceType: ResourceType)
  }

  class Map {
    - size : int
    - name : String
    +checkCoordinates(pos: Position): boolean
  }

  class Position {
    -xCoordinate : int
    -yCoordinate : int
    +Position(xCoordinate: int, yCoordinate: int)
  }

  enum IndustryType{
    Primary Sector
    Transforming
    Mixed
  }

  enum ResourceType{
    Iron
    Coal
    Bauxite
    Nitrate Mines
    Vegetables
    Cereals
    Wool
    Coffee
    Rubber
    Cattle
    Bakery
    Textile
    Automobile
    Steel Mill
  }


CreateIndustryUI ..> CreateIndustryController
CreateIndustryController ..>  Repositories
CreateIndustryController ..>  MapRepository
CreateIndustryController ..>  Map
CreateIndustryController ..> Position
CreateIndustryController ..> IndustryType
CreateIndustryController ..> ResourceType
CreateIndustryController ..> Industry
Repositories --> "1" MapRepository : map repository
Repositories -> "1" Repositories : instance
MapRepository --> "*" Map : map
Industry --> "1" Position : position
IndustryType --> "1" Industry : industry type
ResourceType --> "1" Industry : resource type

@enduml