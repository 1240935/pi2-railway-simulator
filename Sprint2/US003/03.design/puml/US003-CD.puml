@startuml
skinparam classAttributeIconSize 0

class AddCityUI {

}

class AddCityController {
  +addCity(position, name, blocks)
}

class MapRepository {
  +getSelectedMap() : Map
}

class Repositories {
    - Repositories()
    + {static} getInstance()
    + getMapRepository()
}

class Map {
  +addCity(city: City)
}

class City {
  - position : Position
  - name : String
  - blocks : CityBlocks
  + City(position, name, blocks)
}

class Position {
 - xCoordinate : int
 - yCoordinate : int
}

class CityBlocks{
 - numberBlocks : int
}

AddCityUI ..> AddCityController
AddCityController .> Repositories
AddCityController ..> MapRepository
AddCityController ..> City
AddCityController ..> Map
MapRepository --> "1" Map : selectedMap
Map --> "*" City : cities
Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance
City -> "1" Position
City -> CityBlocks
CityBlocks --> "1" Position

@enduml
