@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods


class Map {
    name
    size
    industries
    cities
}

class Scenario {
    importation
    exportation
    year
    stations
    locomotives
    routes
}

class Editor {
    username
    password
}

class LocomotiveTypes{
}

class IndustryChanger{
    effect
}

class ResourceType{
    value
}

class Station{
    name
    Position
    StationCenter
    StationType
    List<Cargo>
}

class Locomotive{
    id
    LocomotiveModel
}

class Route{
    Station
    List<Station>
    List<Cargo>
    Locomotive
}


Editor "1" - "*" Map : creates >
Editor "1" - "*" Scenario : creates >
Scenario "*" -- "1" Map : uses >
Scenario "*" -- "1..*" IndustryChanger : has >
Scenario "*" -- "1..*" LocomotiveTypes : has >
Scenario "*" -- "1..*" ResourceType : has >
Scenario "*" -- "*" Station : has >
Scenario "*" -- "*" Locomotive : has >
Scenario "*" -- "*" Route : has >
Route "1" -- "2..*" Station : has >
Route "1" -- "1" Locomotive : has >
@enduml
