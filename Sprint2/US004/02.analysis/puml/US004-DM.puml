@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods


class Map {
    name
    size
}

class Scenario {
    importation
    exportation
}

class Editor {
    username
    password
}

class HistoricalRestriction{
}

class TimeRestriction{
    year
}

class TechnologicalRestriction{
}

class IndustryChanger{
    effect
}

Editor "1" - "*" Map : creates >
Editor "1" - "*" Scenario : creates >
Scenario "*" -- "1" Map : uses >
Scenario "1" -- "*" HistoricalRestriction: includes >
Scenario "1" -- "*" TechnologicalRestriction: includes >
Scenario "1" -- "*" TimeRestriction: includes >
HistoricalRestriction "1" -- "*" IndustryChanger: has >

@enduml
