    @startuml
    'skinparam monochrome true
    skinparam packageStyle rectangle
    skinparam shadowing false
    skinparam linetype polyline
    'skinparam linetype orto

    skinparam classAttributeIconSize 0

    'left to right direction

    class CreateScenarioUI{
    }

    class CreateScenarioController {
        +CreateScenarioController()
        +getAvailableMaps()
        +setMap(Map)
        +setYear(year)
        +getLocomotiveTypes()
        +setLocomotiveTypes(types)
        +getIndustryTypes()
        +setIndustryTypes(types)
        +getResourceTypes()
        +setResourceTypes(types)
        +setPortBehavior(behavior)
        +getAvailableIndustryChangers()
        +setIndustryChangers(changers)
        +createScenario(map, year, locomotiveTypes, industryTypes, resourceTypes, behaviour, changers)

    }

    class Repositories {
            -Repositories()
            +getInstance()
            +getMapRepository()
            +getLocomotiveTypeRepository()
            +getIndustryTypeRepository()
            +getResourceTypeRepository()
            +getIndustryChangerRepository()
    }

    class MapRepository {
            +getAvailableMaps()
        }

    class LocomotiveTypeRepository {
          +getLocomotiveTypes()
    }

    class IndustryTypeRepository {
          +getIndustryTypes()
    }

    class ResourceTypeRepository {
          +getResourceTypes()
    }

    class IndustryChangerRepository {
          +getIndustryChangers()
    }

     class Scenario {
       -map: Map
       -year: int
       -locomotiveTypes: List<LocomotiveType>
       -industryTypes: List<IndustryType>
       -resourceTypes: List<ResourceType>
       -importation: boolean
       -changers: List<IndustryChanger>
       +Scenario(map, year, locomotiveTypes, industryTypes, resourceTypes, behavior, changers)
     }

        class Map{
        - size : int
        - name : String
        }

        enum LocomotiveType{
            Steam
            Diesel
            Electric
        }
        enum IndustryType{
            Primary Sector
            Transforming
            Mixed
        }
        enum ResourceType{
            Iron
            Coal
            Bauxite
            Nitrate Mines
            Vegetables
            Cereals
            Wool
            Coffee
            Rubber
            Cattle
            Bakery
            Textile
            Automobile
            Steel Mill
        }
        enum IndustryChanger{
            War
            Vaccination Campaign
            Schooling Program
            --
            -effect: int
        }
        class PortBehavior{
            - behavior: boolean
        }


    CreateScenarioUI ..> CreateScenarioController

    CreateScenarioController ..> Scenario
    CreateScenarioController ..> Repositories

    Repositories --> "1" MapRepository: map repository
    Repositories --> "1" LocomotiveTypeRepository : locomotive type repository
    Repositories --> "1" IndustryTypeRepository : industry type repository
    Repositories --> "1" ResourceTypeRepository : resource type repository
    Repositories --> "1" IndustryChangerRepository : industry changer repository

    MapRepository --> "*" Map : map
    LocomotiveTypeRepository --> "3" LocomotiveType
    IndustryTypeRepository --> "3" IndustryType
    ResourceTypeRepository --> "14" ResourceType
    IndustryChangerRepository --> "3" IndustryChanger

    Scenario --> "1" Map : map
    Scenario --> "1..*" LocomotiveType: locomotive type
    Scenario --> "1..*" ResourceType : resource type
    Scenario --> "1..*" IndustryChanger : industry changer
    Scenario --> "1" PortBehavior: port behavior

    CreateScenarioController ..> Map
    CreateScenarioController ..> LocomotiveType
    CreateScenarioController ..> IndustryType
    CreateScenarioController ..> ResourceType
    CreateScenarioController ..> IndustryChanger
    CreateScenarioController ..> PortBehavior


    @enduml