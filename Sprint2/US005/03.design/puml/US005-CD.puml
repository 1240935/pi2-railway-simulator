@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class BuildStationUI {
  -controller : BuildStationController
  +getAvailableScenarios()
  +setScenario(scenario)
  +createPosition(xCoordinate, yCoordinate)
  +checkPosition(position)
  +setType(type)
  +setGeometricCenter(position)
  +setCompassCenter(compassCoord)
  +getName(city)
  +setName(name)
  +buildStation()
}

class BuildStationController {
  -scenarioRepo : ScenarioRepository
  -stationRepo : StationRepository
  -selectedScenario : Scenario
  -name : String
  -type : StationType
  -position : Position
  -center : Position
  +getAvailableScenarios() : List<Scenario>
  +setScenario(scenario)
  +createPosition(xCoordinate, yCoordinate) : Position
  +checkPosition(pos : Position) : boolean
  +getClosestCity(pos : Position) : City
  +getAvailableStationTypes() : List<StationType>
  +setType(type : StationType)
  +setGeometricCenter(pos : Position)
  +setCompassCenter(compassCoord : String)
  +getName(city : City) : String
  +setName(name : String)
  +buildStation() : void
}

class Scenario {
  -cities : List<City>
  -stations : List<Station>
  +checkCoordinates(pos : Position) : boolean
  +getClosestCity(pos : Position) : City
}

class City {
  -name : String
  -position : Position
  +getName() : String
  +getPosition() : Position
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
  +Station(name, position, type, center)
}

class Position {
  -xCoordinate : int
  -yCoordinate : int
  +Position(xCoordinate : int, yCoordinate : int)
  +distanceTo(position : Position) : double
}

enum StationType {
  Depot
  Terminal
  Station
  --
  radius : int
  cost : int
}

class ScenarioRepository {
  +getScenarios() : List<Scenario>
  +getScenario(scenario) : Scenario
}

class StationRepository {
  +save(station : Station)
}

BuildStationUI ..> BuildStationController
BuildStationController ..> ScenarioRepository
BuildStationController ..> StationRepository
BuildStationController ..> Scenario
BuildStationController ..> StationType
ScenarioRepository --> "1..*" Scenario  : scenario
StationRepository --> "*" Station : station
Scenario --> "1..*" City : city
Scenario --> "*" Station : station
City --> "1" Position : position
Station --> "1" Position : position
Station --> "1" StationType : station type
Position -> "1" Position : distance to

@enduml
