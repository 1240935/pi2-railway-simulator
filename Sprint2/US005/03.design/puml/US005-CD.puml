@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class BuildStationUI {
}

class BuildStationController {
  +getAvailableScenarios() : List<Scenario>
  +setScenario(scenario: Scenario)
  +createPosition(xCoordinate: int, yCoordinate: int) : Position
  +checkPosition(pos: Position) : boolean
  +getClosestCity(pos: Position) : City
  +getAvailableStationTypes(): List<StationType>
  +setType(type: StationType)
  +setGeometricCenter(pos: Position)
  +setCompassCenter(compassCoord: String)
  +getName(city : City) : String
  +setName(name : String)
  +createStation(position: position, name: String, type: StationType, center: Position)
}

class Repositories {
      - Repositories()
      + getInstance()
      + getScenarioRepository()
  }

class Scenario {
  -cities : List<City>
  -stations : List<Station>
  +checkCoordinates(pos: Position) : boolean
  +getClosestCity(pos: Position) : City
}

class City {
  -name : String
  -position : Position
  +getName() : String
  +getPosition() : Position
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
  +Station(name, position, type, center)
}

class Position {
  -xCoordinate : int
  -yCoordinate : int
  +Position(xCoordinate : int, yCoordinate : int)
  +distanceTo(position : Position) : double
}

enum StationType {
  Depot
  Terminal
  Station
  --
  radius : int
  cost : int
}

class ScenarioRepository {
  +getScenarioRepository() : List<Scenario>
  +getScenario(scenario) : Scenario
}

BuildStationUI ..> BuildStationController
BuildStationController ..> ScenarioRepository
BuildStationController ..> Scenario
BuildStationController ..> StationType
BuildStationController ..> Repositories
Repositories --> "1" ScenarioRepository : scenario repository
Repositories -> "1" Repositories : instance
ScenarioRepository --> "1..*" Scenario  : scenario
Scenario --> "1..*" City : city
Scenario --> "*" Station : station
City --> "1" Position : position
Station --> "1" Position : position
Station --> "1" StationType : station type
Position -> "1" Position : distance to

@enduml
