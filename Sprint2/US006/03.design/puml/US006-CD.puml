@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class UpgradeStationUI {
}

class UpgradeStationController {
    + UpgradeStationController()
    + getAvailableScenarios()
    + setScenario(scenario : Scenario)
    + getAvailableStations()
    + setStation(station : Station)
    + getAvailableBuildingTypes(station : Station) : List<BuildingType>
    + setType(type : BuildingType)
    + createBuilding(station : Station, type : BuildingType) : Building
}

class ScenarioRepository {
    + getScenarios() : List<Scenario>
}

class StationRepository {
    + getStations() : List<Station>
}

class Repositories {
    - Repositories()
    + getInstance()
    + getScenarioRepository()
    + getStationRepository()
}

enum BuildingType {
    Telegraph/Telephone
    Small Café
    Large Café
    Customs
    Post office
    Small hotel
    Large hotel
    Silo
    Liquid Storage
    --
    upgrade : int
    cost : int
}

class Building {
    -station: Station
    -type: BuildingType
    + Building(station, type)
}

class Station{
    -name : String
    -position : Position
    -type : StationType
    -center : Position
}

class Scenario{
   -station : List<Station>
}


' Relationships
UpgradeStationUI ..> UpgradeStationController
UpgradeStationController ..> Repositories
UpgradeStationController ..> ScenarioRepository
UpgradeStationController ..> StationRepository
UpgradeStationController ..> BuildingType
UpgradeStationController ..> Building
UpgradeStationController ..> Scenario
ScenarioRepository --> "1..*" Scenario  : scenario
StationRepository --> "1..*" Station  : station
Scenario --> "*" Station : station
Station --> "*" Building : building
Repositories --> "1" ScenarioRepository : scenario repository
Repositories -> "1" Repositories : instance
Repositories --> "1" StationRepository : station repository
BuildingType --> "1" Building : building type


@enduml