@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class UpgradeStationUI {

}

class UpgradeStationController {
    + UpgradeStationController()
    + getAvailableScenarios()
    + setScenario(scenario : Scenario)
    + getAvailableStations()
    + setStation(station : Station)
    + getAvailableUpgrades(Station) : List<UpgradeType>
    + setUpgrade(upgrade : Upgrade)
    + createBuilding(station : Station, upgrade : Upgrade) : Building
}

class ScenarioRepository {
    + getScenarios() : List<Scenario>
}

class StationRepository {
    + getStations() : List<Station>
}

class Repositories {
    - Repositories()
    + getInstance()
    + getScenarioRepository()
    + getStationRepository()
}

enum UpgradeType {
    lista dos upgrades <<<<<<<<<<
}

class Building {
    + Building(station, upgrade)
}


' Relationships
UpgradeStationUI ..> UpgradeStationController
UpgradeStationController ..> Repositories
Repositories --> "1" ScenarioRepository
Repositories --> "1" StationRepository
UpgradeStationController ..> ScenarioRepository
UpgradeStationController ..> StationRepository
UpgradeStationController ..> UpgradeType
UpgradeStationController ..> Building
UpgradeStationController ..> Scenario
UpgradeStationController ..> Station
UpgradeStationController ..> UpgradeType

@enduml