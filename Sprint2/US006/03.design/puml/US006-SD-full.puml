@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

 actor "Player" as PLAYER
    participant ":UpgradeStationUI" as UI
    participant ":UpgradeStationController" as CTRL
    participant "Repositories" as REPOS
    participant "ScenarioRepository" as SREPOS
    participant "UpgradeType <<enumeration>>" as UTYPE
    participant "StationRepository" as STREPOS

    activate PLAYER

    PLAYER -> UI : asks to upgrade a station
    activate UI

    UI --> CTRL** : create()

    UI -> CTRL : getAvailableScenarios()
    activate CTRL

    CTRL -> REPOS : getInstance()
    activate REPOS

    REPOS --> CTRL: repositories

    deactivate REPOS

    CTRL -> SREPOS : getScenarioRepository()
    activate SREPOS

    SREPOS --> CTRL : list of scenarios

    deactivate SREPOS
    CTRL --> UI : list of scenarios
    deactivate CTRL

    UI --> PLAYER : shows the list of scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI

    UI -> CTRL :setScenario(scenario)

    activate CTRL

    CTRL --> UI : scenario selected

    deactivate CTRL


        UI -> CTRL : getAvailableStations()
        activate CTRL

        CTRL -> REPOS : getInstance()
        activate REPOS

        REPOS --> CTRL: repositories

        deactivate REPOS

        CTRL -> STREPOS : getStationRepository()
        activate STREPOS

        STREPOS --> CTRL : list of stations

        deactivate STREPOS
        CTRL --> UI : list of stations
        deactivate CTRL

        UI --> PLAYER : shows the list of stations
        deactivate UI

        PLAYER -> UI : selects a station
        activate UI

        UI -> CTRL :setStation(station)

        activate CTRL

        CTRL --> UI : station selected

        deactivate CTRL

        UI -> CTRL : getAvailableUpgrades()
                activate CTRL

                CTRL -> UTYPE : getAvailableUpgradeTypes(station)
                activate UTYPE

                UTYPE --> CTRL : list of upgrades

                deactivate UTYPE
                CTRL --> UI : list of upgrades
                deactivate CTRL

                UI --> PLAYER : shows the list of upgrades
                deactivate UI

                PLAYER -> UI : selects an upgrade
                activate UI

                UI -> CTRL :setUpgrade(upgrade)

                activate CTRL

                CTRL --> UI : upgrade selected

                deactivate CTRL

    UI --> PLAYER: shows all data and requests \n for confirmation
    deactivate  UI

    PLAYER --> UI: confirms data
    activate UI

    UI -> CTRL : createBuilding(station, upgrade)
    activate CTRL

    CTRL -> BUILDING** : create(station, upgrade)

    CTRL --> UI : building
    deactivate CTRL

    UI --> PLAYER : displays operation success
    deactivate UI
    deactivate PLAYER
@enduml