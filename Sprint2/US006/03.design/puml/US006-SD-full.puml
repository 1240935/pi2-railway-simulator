@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

 actor "Player" as PLAYER
    participant ":UpgradeStationUI" as UI
    participant ":UpgradeStationController" as CTRL
    participant "Repositories" as REPOS
    participant "ScenarioRepository" as SREPOS
    participant "BuildingType <<enumeration>>" as BTYPE
    participant "StationRepository" as STREPOS
    participant "Building" as BUILDING
    participant "Station" as STATION

    activate PLAYER

    PLAYER -> UI : asks to upgrade a station
    activate UI

    UI --> CTRL** : create()

    UI -> CTRL : getAvailableScenarios()
    activate CTRL

    CTRL -> REPOS : getInstance()
    activate REPOS

    REPOS --> CTRL: repositories

    deactivate REPOS

    CTRL -> SREPOS : getScenarios()
    activate SREPOS

    SREPOS --> CTRL : list of scenarios

    deactivate SREPOS
    CTRL --> UI : list of scenarios
    deactivate CTRL

    UI --> PLAYER : shows the list of scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI

    UI -> CTRL :setScenario(scenario)

    activate CTRL

    CTRL --> UI : scenario selected

    deactivate CTRL


        UI -> CTRL : getAvailableStations()
        activate CTRL

        CTRL -> REPOS : getInstance()
        activate REPOS

        REPOS --> CTRL: repositories

        deactivate REPOS

        CTRL -> STREPOS : getStations()
        activate STREPOS

        STREPOS --> CTRL : list of stations

        deactivate STREPOS
        CTRL --> UI : list of stations
        deactivate CTRL

        UI --> PLAYER : shows the list of stations
        deactivate UI

        PLAYER -> UI : selects a station
        activate UI

        UI -> CTRL :setStation(station)

        activate CTRL

        CTRL --> UI : station selected

        deactivate CTRL

        UI -> CTRL : getAvailableBuildingTypes()
                activate CTRL

                CTRL -> BTYPE : getAvailableBuildingTypes(station)
                activate BTYPE

                BTYPE --> CTRL : list of building types

                deactivate BTYPE
                CTRL --> UI : list of building types
                deactivate CTRL

                UI --> PLAYER : shows the list of building types
                deactivate UI

                PLAYER -> UI : selects a building type
                activate UI

                UI -> CTRL :setType(type)

                activate CTRL

                CTRL --> UI : type selected

                deactivate CTRL

    UI --> PLAYER: shows all data and requests \n for confirmation
    deactivate  UI

    PLAYER --> UI: confirms data
    activate UI

    UI -> CTRL : createBuilding(station, type)
    activate CTRL

    CTRL -> BUILDING** : create(station, type)

    CTRL --> UI : building
    deactivate CTRL

    UI -> CTRL: setBuilding(building)
    activate CTRL
    CTRL -> STATION : setBuilding(building)
    activate STATION
    STATION --> CTRL: building set
    deactivate STATION
    CTRL --> UI: building set
    deactivate CTRL

    UI --> PLAYER : displays operation success
    deactivate UI
    deactivate PLAYER
@enduml