@startuml
skinparam classAttributeIconSize 0

class StationListUI {
}

class StationListController {
  +getStations(): List<Station>
  +selectStation(stationId): StationDetails
}

class MapRepository {
  +getSelectedMap(): Map
}

class Repositories {
  - Repositories()
  + {static} getInstance()
  + getMapRepository(): MapRepository
}

class Map {
  +getStations(): List<Station>
}

class Station {
  - id: int
  - name: String
  - position: Position
  - buildings: List<Building>
  - cargoInfo: CargoInfo
}

class Position {
  - xCoordinate: int
  - yCoordinate: int
}

class Building {
  - type: String
}

class CargoInfo {
  - demand: List<Cargo>
  - supply: List<Cargo>
}

class Cargo {
  - name: String
  - quantity: int
}

class StationDetails {
  - station: Station
  + StationDetails(station: Station)
}

StationListUI ..> StationListController
StationListController .> Repositories
StationListController ..> MapRepository
StationListController ..> Map
StationListController ..> Station
StationListController ..> StationDetails

MapRepository --> "1" Map : selectedMap
Map --> "*" Station : stations
Station --> "1" Position
Station --> "*" Building : buildings
Station --> "1" CargoInfo
CargoInfo --> "*" Cargo : demand
CargoInfo --> "*" Cargo : supply

Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance

@enduml