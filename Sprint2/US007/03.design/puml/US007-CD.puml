@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction


class ViewStationUI {
}

class ViewStationController {
  +ViewStationController()
  +getAvailableScenarios()
  +setScenario(scenario)
  +getAvailableStations()
  +getBuilding(station)
  +getCargo(station)
}

class Repositories {
  -Repositories()
  +getInstance()
  +getScenarioRepository()
  +getStationRepository()
}

class ScenarioRepository {
  +getScenarios()
}

class StationRepository {
  +getStations()
}

class Scenario {
    -map: Map
    -year: int
    -locomotiveTypes: List<LocomotiveType>
    -industryTypes: List<IndustryType>
    -importation: boolean
    -exportation: boolean
    -changers: List<IndustryChanger>
    +Scenario(map, year, locomotiveTypes, industryTypes, importation, exportation, changers)
}


class Station{
    -name : String
    -position : Position
    -type : StationType
    -center : Position
    -building: Building
    -cargo: Cargo
    +getBuilding(station)
    +getCargo(station)
}

class Building {
    -type: BuildingType
}

class Cargo {
  -type: CargoType
  -quantity: int
}


ViewStationUI ..> ViewStationController
ViewStationController ..> Repositories
ViewStationController ..> ScenarioRepository
ViewStationController ..> StationRepository
ViewStationController ..> Scenario
ViewStationController ..> Station

Repositories -> "1" Repositories : instance
Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" StationRepository : station repository

Scenario --> "*" Station : station

Station --> "*" Building : building
Station --> "*" Cargo : cargo


@enduml