@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox

actor "Player" as PLAYER
participant ":ViewStationUI" as UI
participant ":ViewStationController" as CTRL
participant "Repositories" as REPOS
participant "ScenarioRepository" as SCENARIO_REPO
participant "StationRepository" as STREPOS
participant "Scenario" as SCENARIO
participant "Station" as STATION

activate PLAYER

    PLAYER -> UI : asks to view station
    activate UI
        UI --> CTRL : create()

        UI -> CTRL : getAvailableScenarios()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> SCENARIO_REPO : getScenarios()
            activate SCENARIO_REPO
                SCENARIO_REPO --> CTRL : list of scenarios
            deactivate SCENARIO_REPO

            CTRL --> UI : list of scenarios
        deactivate CTRL

        UI --> PLAYER : shows available scenarios
    deactivate UI

PLAYER -> UI : selects scenario
activate UI
    UI -> CTRL :setScenario(scenario)

        activate CTRL

        CTRL --> UI : scenario selected

        deactivate CTRL


            UI -> CTRL : getAvailableStations()
            activate CTRL

            CTRL -> REPOS : getInstance()
            activate REPOS

            REPOS --> CTRL: repositories

            deactivate REPOS

            CTRL -> STREPOS : getStations()
            activate STREPOS

            STREPOS --> CTRL : list of stations

            deactivate STREPOS
            CTRL --> UI : list of stations
            deactivate CTRL

            UI --> PLAYER : shows the list of stations
            deactivate UI

PLAYER -> UI : selects station
activate UI
    UI -> CTRL : getBuilding(station)
    activate CTRL
        CTRL -> STATION : getBuilding(station)
        activate STATION
            STATION --> CTRL : building
        deactivate STATION
        CTRL --> UI : building
    deactivate CTRL
    UI -> CTRL : getCargo(station)
        activate CTRL
            CTRL -> STATION : getCargo(station)
            activate STATION
                STATION --> CTRL : cargo
            deactivate STATION
            CTRL --> UI : cargo
        deactivate CTRL
    UI --> PLAYER : displays station details and success
deactivate UI

deactivate PLAYER
@enduml