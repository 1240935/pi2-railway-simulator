@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as PLAYER
participant ":StationListUI" as UI
participant ":StationListController" as CTRL
participant "Repositories" as REPOS
participant ":MapRepository" as MAP_REPOS
participant "Map" as MAP
participant "Station" as STATION
participant "StationDetails" as DETAILS
participant "Building" as BUILDING
participant "CargoInfo" as CARGOINFO
participant "Cargo" as CARGO

activate PLAYER

    PLAYER -> UI : asks to see stations
    activate UI
        UI --> CTRL** : create()
        UI -> CTRL : getAvailableScenarios()
            activate CTRL
            CTRL -> REPOS : getInstance()
                activate REPOS
                REPOS --> CTRL : repositories
                deactivate REPOS
            CTRL -> MAP_REPOS : getMapRepository()
                activate MAP_REPOS
                MAP_REPOS --> CTRL : mapRepository
                deactivate MAP_REPOS
            CTRL -> MAP : getStations()
                activate MAP
                MAP --> CTRL : stations
                deactivate MAP
            CTRL --> UI : availableScenarios (stations)
            deactivate CTRL

        UI --> PLAYER : shows available scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI
        UI -> CTRL : selectScenario(scenarioId)
        activate CTRL
        CTRL -> MAP : getStations()
            activate MAP
            MAP --> CTRL : stations
            deactivate MAP
        CTRL --> UI : list of stations
        deactivate CTRL
        UI --> PLAYER : shows list of stations
    deactivate UI

    PLAYER -> UI : selects a station
    activate UI
        UI -> CTRL : selectStation(stationId)
        activate CTRL
        CTRL -> MAP : getStations()
        activate MAP
        MAP --> CTRL : stations
        deactivate MAP
        CTRL -> STATION : getDetails()
        activate STATION
        STATION -> BUILDING : getBuildings()
        STATION -> CARGOINFO : getCargoInfo()
        activate CARGOINFO
        CARGOINFO -> CARGO : getDemand()
        CARGOINFO -> CARGO : getSupply()
        deactivate CARGOINFO
        STATION --> CTRL : station details
        deactivate STATION
        CTRL -> DETAILS** : create(station)
        CTRL --> UI : station details
        deactivate CTRL

        UI --> PLAYER : shows station details and success
    deactivate UI

deactivate PLAYER
@enduml