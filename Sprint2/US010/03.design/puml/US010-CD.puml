@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class AssignRouteUI {

}

class AssignRouteController {
    +create()
      +getAvailableScenarios(): List<Scenario>
      +setScenario(scenario: Scenario)
      +getAvailableLocomotives(): List<Locomotive>
      +setLocomotive(locomotive: Locomotive)
      +getAvailableStations(): List<Station>
      +addStation(station: Station)
      +checkStationConnection(station: Station): boolean
      +checkCargo(station: Station): List<Cargo>
      +setCargo(cargo: Cargo)
      +createRoute(locomotive: Locomotive, stations: List<Station>, cargo: Cargo): Route
}

class Repositories {
  +getInstance(): Repositories
  +getScenarioRepository(): ScenarioRepository
  +getStationRepository(): StationRepository
  +getLocomotiveRepository(): LocomotiveRepository
}

class ScenarioRepository {
  +list(): List<Scenario>
}

class StationRepository {
  +list(): List<Station>
}

class LocomotiveRepository {
  +list(): List<Locomotive>
}

class Scenario {
  +checkStationConnection(station: Station): boolean
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
  +checkCargo(): List<Cargo>
}

class Route {
  +create(locomotive: Locomotive, stations: List<Station>, cargo: Cargo): Route
  -stations: List<Station>
  -locomotive: Locomotive
  -cargo: Cargo
}

class Locomotive {
  -power: int
  -acceleration: int
  -topSpeed: int
  -operationStartYear: int
  -fuelCost: int
  -maintenancePYear: int
  -cost: int
  -iD: int
}

class Cargo {
  -quantity: int
  -status: boolean
  -type: CargoType
}


AssignRouteUI ..> AssignRouteController
AssignRouteController ..> Repositories
Repositories -> "1" Repositories : instance
Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" StationRepository : station repository
Repositories --> "1" LocomotiveRepository : locomotive repository

AssignRouteController ..> Route
AssignRouteController ..> Scenario
AssignRouteController ..> Locomotive
AssignRouteController ..> Cargo

Route --> "1" Locomotive : locomotive
Route --> "2..*" Station : station
Route --> "1..*" Cargo : cargo
@enduml