@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class AssignRouteUI {

}

class AssignRouteController {
      +AssignRouteController()
      +getAvailableScenarios()
      +setScenario(scenario)
      +getAvailableLocomotives()
      +setLocomotive(locomotive)
      +getAvailableStations()
      +addStation(station)
      +checkStationConnection(station)
      +checkCargo(station)
      +setCargo(cargo)
      +createRoute(locomotive, stations, cargo)
}

class Repositories {
  +getInstance()
  +getScenarioRepository()
  +getStationRepository()
  +getLocomotiveRepository()
}

class ScenarioRepository {
  +getAvailableScenarios()
}

class StationRepository {
  +getAvailableLocomotives()
}

class LocomotiveRepository {
  +getAvailableLocomotives()
}

class Scenario {
    -map: Map
    -year: int
    -locomotiveTypes: List<LocomotiveType>
    -industryTypes: List<IndustryType>
    -resourceTypes: List<ResourceType>
    -behavior: boolean
    -changers: List<IndustryChanger>
    +checkStationConnection(station)
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
  +checkCargo()
}

class Route {
  +create(locomotive, stations, cargo)
  -stations: List<Station>
  -locomotive: Locomotive
  -cargo: Cargo
}

class Locomotive {
  -iD: int
  -model: LocomotiveModel
}

class Cargo {
  -quantity: int
  -status: boolean
  -type: CargoType
}


AssignRouteUI ..> AssignRouteController
AssignRouteController ..> Repositories
Repositories -> "1" Repositories : instance
Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" StationRepository : station repository
Repositories --> "1" LocomotiveRepository : locomotive repository

AssignRouteController ..> Route
AssignRouteController ..> Scenario
AssignRouteController ..> Locomotive
AssignRouteController ..> Cargo

StationRepository --> "*" Station : station
LocomotiveRepository --> "*" Locomotive: locomotive
ScenarioRepository --> "*" Scenario: scenario

Scenario --> "*" Station : station
Scenario --> "*" Locomotive : locomotive
Scenario --> "*" Cargo : cargo

Route --> "1" Locomotive : locomotive
Route --> "2..*" Station : station
Route --> "1..*" Cargo : cargo
@enduml