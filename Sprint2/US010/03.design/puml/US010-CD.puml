@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class AssignRouteUI {

}

class AssignRouteController {
    + getAvailableScenarios()
    + setScenario(scenario : Scenario)
    + getAvailableLocomotives()
    + setLocomotive(locomotive : Locomotive)
    + getAvailableStations()
    + addStationToRoute(station: Station)
    + checkStationConnection(): boolean
    + checkForCargo(): List<Cargo>
    + setCargo(cargo : Cargo)
    + createFullRoute(route: Route, locomotive : Locomotive, cargo : Cargo): FullRoute
}

class Repositories {
   - Repositories()
       + getInstance()
       + getScenarioRepository()
       + getStationRepository()
       + getLocomotiveRepository()
}

class ScenarioRepository {
   + getScenarios() : List<Scenario>
}

class StationRepository {
     + getStations() : List<Station>
}

class LocomotiveRepository {
    + getLocomotives() : List<Locomotive>
}

class Route {
    - stations: List<Station>
    - cargo: List<Cargo>
    + addStation(Station): void
    + checkForCargo(): List<Cargo>
}

class FullRoute {
    + create(Route, Locomotive, Cargo): FullRoute
}


' Relationships
AssignRouteUI ..> AssignRouteController
AssignRouteController ..> Repositories
Repositories -> "1" Repositories : instance
Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" StationRepository : station repository
Repositories --> "1" LocomotiveRepository : locomotive repository

AssignRouteController ..> Route
AssignRouteController ..> FullRoute
AssignRouteController ..> Scenario
AssignRouteController ..> Locomotive
AssignRouteController ..> Cargo

Route --> Station
Route --> Cargo

@enduml