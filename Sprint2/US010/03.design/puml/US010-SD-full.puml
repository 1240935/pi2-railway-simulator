@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

 actor "Player" as PLAYER
    participant ":AssignRouteUI" as UI
    participant ":AssignRouteController" as CTRL
    participant "Repositories" as REPOS
    participant "ScenarioRepository" as SREPOS
    participant "StationRepository" as STREPOS
    participant "LocomotiveRepository" as LOCREPOS
    participant "Railway" as RAILWAY
    participant "Station" as STATION
    participant "Route" as ROUTE

    activate PLAYER

    PLAYER -> UI : asks to assign a train to a route
    activate UI

    UI --> CTRL** : create()

    UI -> CTRL : getAvailableScenarios()
    activate CTRL

    CTRL -> REPOS : getInstance()
    activate REPOS

    REPOS --> CTRL: repositories

    deactivate REPOS

    CTRL -> SREPOS : getAvailableScenarios()
    activate SREPOS

    SREPOS --> CTRL : list of scenarios

    deactivate SREPOS
    CTRL --> UI : list of scenarios
    deactivate CTRL

    UI --> PLAYER : shows the list of scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI

    UI -> CTRL :setScenario(scenario)

    activate CTRL

    CTRL --> UI : scenario selected

    deactivate CTRL


        UI -> CTRL : getAvailableLocomotives()
        activate CTRL

        CTRL -> REPOS : getInstance()
        activate REPOS

        REPOS --> CTRL: repositories

        deactivate REPOS

        CTRL -> LOCREPOS : getAvailableLocomotives()
        activate LOCREPOS

        LOCREPOS --> CTRL : list of locomotives
        deactivate LOCREPOS
        CTRL --> UI : list of locomotives
        deactivate CTRL

        UI --> PLAYER : shows the list of locomotives
        deactivate UI

        PLAYER -> UI : selects a locomotive
        activate UI

        UI -> CTRL :setLocomotive(locomotive)

        activate CTRL

        CTRL --> UI : locomotive selected

        deactivate CTRL

        UI -> CTRL : getAvailableStations()
                activate CTRL

                CTRL -> REPOS : getInstance()
                activate REPOS

                REPOS --> CTRL: repositories

                deactivate REPOS

                CTRL -> STREPOS : getAvailableStations()
                activate STREPOS

                STREPOS --> CTRL : list of stations

                deactivate STREPOS
                CTRL --> UI : list of stations
                deactivate CTRL

                loop selecting the route's stations

                UI --> PLAYER : shows the list of stations
                deactivate UI

                PLAYER -> UI : selects a station
                activate UI

                UI -> CTRL : addStation(station)

                activate CTRL

                CTRL --> UI : station added

                deactivate CTRL

                UI -> CTRL : checkStationConnection(previousStation, station)
                   activate CTRL

                       CTRL -> RAILWAY : areConnected(previousStation, station)

                       activate RAILWAY

                           RAILWAY --> CTRL : connection
                       deactivate RAILWAY

                   CTRL --> UI : connection
                   deactivate CTRL
                end loop

                UI -> CTRL : checkCargo(station)
                activate CTRL

                CTRL -> STATION: checkCargo(station)
                activate STATION

                STATION --> CTRL : list of available cargo
                deactivate STATION

                CTRL --> UI : list of available cargo
                deactivate CTRL


                UI --> PLAYER : shows available cargo
                deactivate UI


                PLAYER -> UI : selects cargo
                activate UI

                UI -> CTRL : setCargo(cargo)
                activate CTRL

                CTRL --> UI : cargo selected
                deactivate CTRL

    UI --> PLAYER: shows all data and requests \n for confirmation
    deactivate UI

    PLAYER -> UI: confirms data
    activate UI

    UI -> CTRL : createRoute(beginningStation, endingStation, stops, locomotive, cargo)
    activate CTRL

    CTRL -> ROUTE** : create(beginningStation, endingStation, stops, locomotive, cargo)

    CTRL --> UI : route
    deactivate CTRL

    UI --> PLAYER : displays operation success
    deactivate UI
    deactivate PLAYER
@enduml