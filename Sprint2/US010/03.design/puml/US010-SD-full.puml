@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

 actor "Player" as PLAYER
    participant ":AssignRouteUI" as UI
    participant ":AssignRouteController" as CTRL
    participant "Repositories" as REPOS
    participant "ScenarioRepository" as SREPOS
    participant "StationRepository" as STREPOS
    participant "Route" as ROUTE
    participant "FullRoute" as FULLROUTE

    activate PLAYER

    PLAYER -> UI : asks to assign a route to a train
    activate UI

    UI --> CTRL** : create()

    UI -> CTRL : getAvailableScenarios()
    activate CTRL

    CTRL -> REPOS : getInstance()
    activate REPOS

    REPOS --> CTRL: repositories

    deactivate REPOS

    CTRL -> SREPOS : getScenarioRepository()
    activate SREPOS

    SREPOS --> CTRL : list of scenarios

    deactivate SREPOS
    CTRL --> UI : list of scenarios
    deactivate CTRL

    UI --> PLAYER : shows the list of scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI

    UI -> CTRL :setScenario(scenario)

    activate CTRL

    CTRL --> UI : scenario selected

    deactivate CTRL


        UI -> CTRL : getAvailableLocomotives()
        activate CTRL

        CTRL -> REPOS : getInstance()
        activate REPOS

        REPOS --> CTRL: repositories

        deactivate REPOS

        CTRL -> LREPOS : getLocomotiveRepository()
        activate LREPOS

        LREPOS --> CTRL : list of locomotives
        deactivate LREPOS

        deactivate LTREPOS
        CTRL --> UI : list of locomotives
        deactivate CTRL

        UI --> PLAYER : shows the list of locomotives
        deactivate UI

        PLAYER -> UI : selects a locomotive
        activate UI

        UI -> CTRL :setLocomotive(locomotive)

        activate CTRL

        CTRL --> UI : locomotive selected

        deactivate CTRL

        UI -> CTRL : getAvailableStations()
                activate CTRL

                CTRL -> REPOS : getInstance()
                activate REPOS

                REPOS --> CTRL: repositories

                deactivate REPOS

                CTRL -> STREPOS : getStationRepository()
                activate STREPOS

                STREPOS --> CTRL : list of stations

                deactivate STREPOS
                CTRL --> UI : list of stations
                deactivate CTRL

                loop selecting the route's stations

                UI --> PLAYER : shows the list of stations
                deactivate UI

                PLAYER -> UI : selects a station
                activate UI

                UI -> CTRL : Route.add(station)

                activate CTRL

                CTRL --> UI : station added to route

                deactivate CTRL

                end loop

                UI -> CTRL : checkStationConnection(Route)
                activate CTRL

                CTRL -> MAP : checkStationConnection(Route)
                    activate MAP

                    MAP --> CTRL : connection exists
                    deactivate MAP

                    CTRL --> UI : connection exists
                    deactivate CTRL

                UI -> CTRL : checkForCargo(Route)
                activate CTRL

                CTRL -> ROUTE** : checkForCargo(station)
                activate ROUTE

                ROUTE --> CTRL : list of cargo
                deactivate ROUTE

                CTRL --> UI : list of cargo
                deactivate CTRL


                UI --> PLAYER : shows available cargo
                deactivate UI


                PLAYER -> UI : selects cargo
                activate UI

                UI -> CTRL : setCargo(cargo)
                activate CTRL

                CTRL --> UI : cargo selected
                deactivate CTRL

    UI --> PLAYER: shows all data and requests \n for confirmation
    deactivate  UI

    PLAYER -> UI: confirms data
    activate UI

    UI -> CTRL : createFullRoute(route, locomotive, cargo)
    activate CTRL

    CTRL -> FULLROUTE** : create(route, locomotive, cargo)

    CTRL --> UI : route
    deactivate CTRL

    UI --> PLAYER : displays operation success
    deactivate UI
    deactivate PLAYER
@enduml