@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class CargoSimulatorUI {

}

class CargoSimulatorController {
  + getAvailableScenarios(
  + setScenario(scenario)
  + getAvailableStations()
  + getCargo(List<Station>)
  + createSimulator(status, stations, cargo)
  + setStatus(simulator)
  + addQuantity(cargo)
  + changeStatus(status)
}

class Simulator {
  - status: String
  - stations: List<Station>
  - cargo: List<Cargo>
  + create(status, stations, cargo)
  + setStatus(status)
  + addQuantity(cargo)
  + getCargo()
}

class Scenario {
       -map: Map
       -year: int
       -locomotiveTypes: List<LocomotiveType>
       -industryTypes: List<IndustryType>
       -importation: boolean
       -exportation; boolean
       -changers: List<IndustryChanger>
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
  +checkCargo(station)
}


class Cargo {
  -quantity: int
  -status: boolean
  -type: CargoType
}

class Repositories {
  + getInstance()
  + getScenarioRepository()
  + getStationRepository()
}

class ScenarioRepository {
  + getAvailableScenarios()
}

class StationRepository {
  + getAvailableStations()
}

CargoSimulatorUI ..> CargoSimulatorController

CargoSimulatorController ..> Simulator
CargoSimulatorController ..> ScenarioRepository
CargoSimulatorController ..> StationRepository
CargoSimulatorController ..> Station
CargoSimulatorController ..> Repositories

Repositories -> "1" Repositories : instance
Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" StationRepository : station repository

StationRepository --> "*" Station : station
ScenarioRepository --> "*" Scenario: scenario

Scenario --> "*" Station : station

Simulator --> "*" Station: station
Simulator --> "*" Cargo: cargo

@enduml