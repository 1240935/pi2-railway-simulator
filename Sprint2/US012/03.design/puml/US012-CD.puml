@startuml
skinparam classAttributeIconSize 0

class CargoSimulatorUI {
}

class CargoSimulatorController {
  +runSimulation()
}

class Repositories {
  - Repositories()
  + {static} getInstance()
  + getMapRepository(): MapRepository
}

class MapRepository {
  +getSelectedMap(): Map
}

class Map {
  +getStations(): List<Station>
  +getCities(): List<City>
  +getIndustries(): List<Industry>
  +getRailwayNetwork(): RailwayNetwork
}

class Station {
  - id: int
  - name: String
  - position: Position
  - cargoInfo: CargoInfo
  + addCargo(cargo: Cargo)
}

class City {
  - name: String
  - position: Position
  - demand: List<Cargo>
}

class Industry {
  - name: String
  - position: Position
  - supply: List<Cargo>
}

class Position {
  - xCoordinate: int
  - yCoordinate: int
}

class RailwayNetwork {
  +isConnected(from: Station, to: City): boolean
  +isConnected(from: Station, to: Industry): boolean
}

class CargoInfo {
  - demand: List<Cargo>
  - supply: List<Cargo>
  + addDemand(cargo: Cargo)
  + addSupply(cargo: Cargo)
}

class Cargo {
  - name: String
  - quantity: int
}

CargoSimulatorUI ..> CargoSimulatorController
CargoSimulatorController .> Repositories
CargoSimulatorController ..> MapRepository
CargoSimulatorController ..> Map
CargoSimulatorController ..> Station
CargoSimulatorController ..> City
CargoSimulatorController ..> Industry
CargoSimulatorController ..> RailwayNetwork
CargoSimulatorController ..> Cargo
CargoSimulatorController ..> CargoInfo

Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance

MapRepository --> "1" Map : selectedMap
Map --> "*" Station : stations
Map --> "*" City : cities
Map --> "*" Industry : industries
Map --> "1" RailwayNetwork : network

Station --> "1" Position
City --> "1" Position
Industry --> "1" Position

Station --> "1" CargoInfo
CargoInfo --> "*" Cargo : demand
CargoInfo --> "*" Cargo : supply

City --> "*" Cargo : demand
Industry --> "*" Cargo : supply

@enduml