@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as PLAYER
participant ":CargoSimulatorUI" as UI
participant ":CargoSimulatorController" as CTRL
participant "Repositories" as REPOS
participant "ScenarioRepository" as SREPOS
participant "StationRepository" as STREPOS
participant "Station" as STATION
participant "Simulator" as SIMULATOR

activate PLAYER

    PLAYER -> UI : requests to start the cargo generation simulator
    activate UI

        UI --> CTRL** : create()

            UI -> CTRL : getAvailableScenarios()
            activate CTRL

            CTRL -> REPOS : getInstance()
            activate REPOS

            REPOS --> CTRL: repositories

            deactivate REPOS

            CTRL -> SREPOS : getAvailableScenarios()
            activate SREPOS

            SREPOS --> CTRL : list of scenarios

            deactivate SREPOS
            CTRL --> UI : list of scenarios
            deactivate CTRL

            deactivate UI

            UI --> PLAYER : shows the list of scenarios
    activate UI

        UI -> CTRL : setScenario(scenario)
        activate CTRL

        CTRL --> UI : scenario selected
        deactivate CTRL
        UI -> CTRL : getAvailableStations()
        activate CTRL

        CTRL -> REPOS : getInstance()
          activate REPOS

        REPOS --> CTRL: repositories

        deactivate REPOS

        CTRL -> STREPOS : getAvailableStations()
        activate STREPOS

        STREPOS --> CTRL : list of available stations
        deactivate STREPOS

        CTRL --> UI: list of available stations
        deactivate CTRL

        UI -> CTRL: getCargo(stations)

        activate CTRL

        CTRL -> STATION: getCargo(stations)

        activate STATION

        STATION --> CTRL: cargo

        deactivate STATION

        CTRL --> UI: cargo
        deactivate CTRL

        UI -> CTRL: createSimulator(status, stations, cargo)

        activate CTRL

        CTRL -> SIMULATOR** : create(status, stations, cargo)

        CTRL --> UI : simulator

        deactivate CTRL

        UI -> CTRL: setStatus(simulator)

       activate CTRL

       CTRL--> UI: status
       deactivate CTRL

       loop until cargo quantity reaches 24

       UI -> CTRL: addQuantity(cargo)

       activate CTRL

       CTRL --> UI: quantity
       deactivate CTRL
       end loop


        UI --> PLAYER : starts cargo generation
        deactivate UI

    alt simulator pause

        PLAYER -> UI : requests to pause the simulator
        activate UI
            UI -> CTRL : changeStatus(status)

            activate CTRL

            CTRL --> UI : pause
            deactivate CTRL
        UI --> PLAYER : simulator paused and awaiting update
        deactivate UI

        PLAYER -> UI : requests to restart the simulator
        activate UI

            UI -> CTRL : changeStatus(status)
            activate CTRL

            CTRL --> UI : play
            deactivate CTRL

             loop until cargo quantity reaches 24

                   UI -> CTRL: addQuantity(cargo)

                   activate CTRL

                   CTRL --> UI: quantity
                   deactivate CTRL
                   end loop
            deactivate CTRL
        UI --> PLAYER : simulator resumed

    end alt

    UI -> CTRL: getCargo(stations)

            activate CTRL

            CTRL -> STATION: getCargo(stations)

            activate STATION

            STATION --> CTRL: cargo

            deactivate STATION

            CTRL --> UI: cargo
            deactivate CTRL

    UI --> PLAYER : shows final generated cargo
    deactivate UI

    PLAYER -> UI : confirms the generation data
    activate UI

    UI --> PLAYER : displays operation success
    deactivate UI

deactivate PLAYER
@enduml