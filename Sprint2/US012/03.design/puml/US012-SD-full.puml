@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Product Owner" as PO
participant ":CargoSimulatorUI" as UI
participant ":CargoSimulatorController" as CTRL
participant "Repositories" as REPOS
participant ":MapRepository" as MAP_REPOS
participant "Map" as MAP
participant "Station" as STATION
participant "City" as CITY
participant "Industry" as INDUSTRY
participant "RailwayNetwork" as NETWORK
participant "CargoInfo" as INFO
participant "Cargo" as CARGO

activate PO

    PO -> UI : requests to start the cargo generation simulator
    activate UI
        UI -> CTRL : getAvailableScenarios()
        activate CTRL
            CTRL -> REPOS : getInstance()
                activate REPOS
                REPOS --> CTRL : repositories
                deactivate REPOS

            CTRL -> MAP_REPOS : getMapRepository()
                activate MAP_REPOS
                MAP_REPOS --> CTRL : mapRepository
                deactivate MAP_REPOS

            CTRL -> MAP_REPOS : getSelectedMap()
                activate MAP_REPOS
                MAP_REPOS --> CTRL : map
                deactivate MAP_REPOS

            CTRL --> UI : available scenarios
        deactivate CTRL

        UI --> PO : displays list of available scenarios
    deactivate UI

    PO -> UI : selects a scenario
    activate UI
        UI -> CTRL : startSimulation()
        activate CTRL

            CTRL -> MAP : getStations()
            activate MAP
            MAP --> CTRL : stations
            deactivate MAP

            CTRL -> MAP : getCities()
            activate MAP
            MAP --> CTRL : cities
            deactivate MAP

            CTRL -> MAP : getIndustries()
            activate MAP
            MAP --> CTRL : industries
            deactivate MAP

            CTRL -> MAP : getRailwayNetwork()
            activate MAP
            MAP --> CTRL : railway network
            deactivate MAP

            loop for each station
                CTRL -> NETWORK : isConnected(station, city)
                alt connected to city
                    CTRL -> CITY : getDemand()
                    CITY --> CTRL : cargoDemand
                    CTRL -> STATION : getCargoInfo()
                    activate STATION
                    STATION --> CTRL : info
                    deactivate STATION
                    CTRL -> INFO : addDemand(cargoDemand)
                end alt

                CTRL -> NETWORK : isConnected(station, industry)
                alt connected to industry
                    CTRL -> INDUSTRY : getSupply()
                    INDUSTRY --> CTRL : cargoSupply
                    CTRL -> STATION : getCargoInfo()
                    activate STATION
                    STATION --> CTRL : info
                    deactivate STATION
                    CTRL -> INFO : addSupply(cargoSupply)
                end alt
            end loop

        CTRL --> UI : simulation complete
        deactivate CTRL

        UI --> PO : simulation running...
    deactivate UI

    alt simulator pause

        PO -> UI : requests to pause the simulator
        activate UI
            UI -> CTRL : pauseSimulation()
            activate CTRL
            CTRL --> UI : simulation paused
            deactivate CTRL
        UI --> PO : simulator paused and awaiting update
        deactivate UI

        PO -> UI : requests to restart the simulator
        activate UI
            UI -> CTRL : resumeSimulation()
            activate CTRL
            CTRL --> UI : simulator resumed
            deactivate CTRL
        UI --> PO : simulator resumed
        deactivate UI

    end alt

    UI --> PO : shows final generated cargo
    deactivate UI

    PO -> UI : confirms the generation data
    activate UI
        UI -> CTRL : confirmSimulationData()
        activate CTRL
        CTRL --> UI : operation success
        deactivate CTRL
    UI --> PO : displays operation success
    deactivate UI

deactivate PO
@enduml