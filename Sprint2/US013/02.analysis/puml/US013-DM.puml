@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

left to right direction

class Player {
    name
    password
    budget
}

class Locomotive {
    locomotion
    power
    acceleration
    topSpeed
    operationStartYear
    fuelCost
    maintenancePYear
    cost
    iD
}

class Route {
    beginningStation
    stops
    finishStation
}

class Station {
    type
    positionXY
    centre
    name
    cost
    capacity
    radius
}

class Cargo {
    type
    quantity
    status
}

class Railway{
    length
    size
    cost
    type
}

Player "1" -- "*" Route : creates >
Player "1" -- "*"  Cargo : selects >
Player "1" -- "1..*" Locomotive : buys >
Railway "1..*" -- "2..*" Station : connects >
Locomotive "1..*" -- "*" Route : assigned to >
Locomotive "1..*" -- "1..*" Cargo : transported by <
Railway "1..*" -- "1" Route: uses <
Station "1" -- "*" Cargo : stores >

@enduml