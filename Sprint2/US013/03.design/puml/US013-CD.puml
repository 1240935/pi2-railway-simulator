@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class VerifyTrainTravelUI {
}

class VerifyTrainTravelController {
  +setStationFile(file: File)
  +setLineFile(file: File)
  +setType(type: LocomotiveType)
  +setStationType(type: StationType)
  +verify(): Graph
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
}

class Line {
  -start: Station
  -end: Station
  -isElectrified: boolean
}

enum LocomotiveType {
  Steam
  Diesel
  Electric
}

enum StationType {
  Depot
  Station
  Terminal
}

class Graph {
  +buildGraph(stations: List<Station>, lines: List<Line>): Graph
}

class PathVerifier {
  +verifyPath(graph: Graph, type: LocomotiveType, stationType: StationType): Graph
}

class Repositories {
  +getInstance(): Repositories
  +getStationRepository(): StationRepository
  +getLineRepository(): LineRepository
}

class StationRepository {
  +loadStations(file: File): List<Station>
}

class LineRepository {
  +loadLines(file: File): List<Line>
}

VerifyTrainTravelUI ..> VerifyTrainTravelController
VerifyTrainTravelController ..> StationRepository
VerifyTrainTravelController ..> LineRepository
VerifyTrainTravelController ..> Graph
VerifyTrainTravelController ..> PathVerifier
VerifyTrainTravelController ..> LocomotiveType
VerifyTrainTravelController ..> StationType
VerifyTrainTravelController ..> Repositories

Repositories --> "1" StationRepository : station repository
Repositories --> "1" LineRepository : line repository

StationRepository --> "1..*" Station : station
LineRepository --> "1..*" Line : line
Graph --> "2..*" Station : station
Graph --> "2..*" Line : line
PathVerifier --> "1" Graph :graph
PathVerifier --> "1" LocomotiveType : locomotive type
PathVerifier --> "1" StationType : station type
Station --> "1" StationType : station type

@enduml