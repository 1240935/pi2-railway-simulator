@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class RailwayMaintenanceUI {

}

class RailwayMaintenanceController {
  +setStationFile(file: File)
  +setLineFile(file: File)
  +setMaintenanceType(type: MaintenanceType)
  +setStartStation(station: Station)
  +setLocomotive(locomotive: Locomotive)
}

class Repositories {
  +getInstance(): Repositories
  +getStationRepository(): StationRepository
  +getLineRepository(): LineRepository
  +getLocomotiveRepository(): LocomotiveRepository
}

class StationRepository {
  +loadStations(file: File): List<Station>
}

class LineRepository {
  +loadLines(file: File): List<Line>
  +getElectrifiedLines(lines: List<Line>): List<Line>
}

class LocomotiveRepository {
  +getAvailableLocomotives(): List<Locomotive>
}

class Graph {
  +buildGraph(stations: List<Station>, lines: List<Line>): Graph
}

class Route {
  +findEulerianPath(graph: Graph): List<Station>
}

class Station {
  -name : String
  -position : Position
  -type : StationType
  -center : Position
}

class Line {
  -start: Station
  -end: Station
  -isElectrified: boolean
}

class Locomotive {
    -power: int
    -acceleration: int
    -topSpeed: int
    -operationStartYear: int
    -fuelCost: int
    -maintenancePYear: int
    -cost: int
    -iD: int
}

enum MaintenanceType {
  Full
  Electrified
}

RailwayMaintenanceUI ..> RailwayMaintenanceController
RailwayMaintenanceController ..> StationRepository
RailwayMaintenanceController ..> LineRepository
RailwayMaintenanceController ..> LocomotiveRepository
RailwayMaintenanceController ..> Graph
RailwayMaintenanceController ..> Route
RailwayMaintenanceController ..> MaintenanceType
RailwayMaintenanceController ..> Repositories
RailwayMaintenanceController ..> Station
RailwayMaintenanceController ..> Line
RailwayMaintenanceController ..> Locomotive

Repositories --> "1" StationRepository : station repository
Repositories --> "1" LineRepository : line repository
Repositories --> "1" LocomotiveRepository : locomotive repository

StationRepository --> "1..*" Station : station
LineRepository --> "1..*" Line : line
Graph --> "1..*" Station : station
Graph --> "2..*" Line : line
Route --> "1" Graph : graph
Route --> "1" MaintenanceType : maintenance type
@enduml