ProductOwner "1" -- "1" Simulator: controls >
Map "1" -- "*" Station : contains >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
Map "1" -- "*" Railway: contains >
Map "1" -- "*" Building: contains >
Position "1" -- "1" City: has <
Position "1" -- "1" Industry: has <
Position "1" -- "1" Station: has <
Position "1" -- "1" Railway: has <
Position "1" -- "1" CityBlock: has <
City "1" -- "*" CityBlock: contains
Scenario "*" -- "1" Map : uses >
