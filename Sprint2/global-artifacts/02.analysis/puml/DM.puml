@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

left to right direction

class Player {
    username
    password
    budget
}

class Editor {
    username
    password
}

class Map {
    name
    size
}

class Position{
    xCoordinate
    yCoordinate
}

class Station {
    type
    centre
    name
    cost
    capacity
    radius
}

class Building {
    type
    cost
    upgrade
}

class Industry {
    type
    resourceType
    resourceGeneration
}

class Scenario {
    portsCargoes
    portsBehaviour
}

class City {
    name
    people
    mail
    finalProduct
}

class CityBlock{
    number
}

class Railway{
    length
    size
    cost
    type
}

class Cargo {
    type
    quantity
    status
}

class Locomotive {
    locomotion
    power
    acceleration
    topSpeed
    operationStartYear
    fuelCost
    maintenancePYear
    cost
    iD
}

class Route {
}

class Simulator{
    status
}

class ProductOwner {
    username
    password
}

class Train {
}

class Carriage{
}

class HistoricalRestriction{
    industryChangers
}

class TimeRestrictions{
    year
}

class TechnologicalRestrictions{
    locomotionTypes
    locomotiveTypes
    industriesTypes
}

Editor "1" -- "*" Map : creates >
