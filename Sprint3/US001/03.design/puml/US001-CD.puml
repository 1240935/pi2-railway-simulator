@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction


class CreateMapUI {

}

class CreateMapController {
  +CreateMapController()
  +createMap(dto)
}

class CreateMapDTO {
    - size : int
    - name : String
    - scale : int
    + getSize()
    + getName()
    + getScale()
}

class CreateMapMapper {
    + toMap(dto)
}

class MapRepository {
    + createMap(dto)
    + addMap(map)
}

class Repositories {
    - Repositories()
    + getInstance()
    + getMapRepository()
}

class Map {
  - size : int
  - name : String
  - scale : int
  - industries : List<Industry>
  - cities : List<City>
  + checkSize(size)
  + checkName(name)
  + checkScale(scale)
}

CreateMapUI ..> CreateMapController

CreateMapController ..> MapRepository
CreateMapController ..> Repositories
CreateMapMapper --> "1" CreateMapDTO: dto
CreateMapMapper --> "1" Map : map
MapRepository --> "1" CreateMapMapper: mapper
MapRepository --> "*" Map: map
Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance


@enduml