@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction


class CreateMapUI {

}

class CreateMapController {
  +CreateMapController()
  +getMap(name)
  +checkName(name)
  +setName(name)
  +checkSize(size)
  +setSize(size)
  +checkScale(scale)
  +setScale(scale)
  +createMap(name, size, scale)
}

class MapRepository {
   +getMapRepository()
}

class Repositories {
    - Repositories()
    + getInstance()
    + getMapRepository()
}

class Map {
  - size : int
  - name : String
  - scale : int
  - industries : List<Industry>
  - cities : List<City>
  + Map(name, size, scale)

}

CreateMapUI ..> CreateMapController
CreateMapController ..> Repositories
CreateMapController ..> MapRepository
CreateMapController ..> Map
MapRepository --> "*" Map : map
Repositories --> "1" MapRepository : mapRepository
Repositories -> "1" Repositories : instance


@enduml