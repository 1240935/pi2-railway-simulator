@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class CreateIndustryUI {
}

class CreateIndustryController {
  +CreateIndustryController()
  +getAvailableMapNames()
  +getMapByIndex(mapIndex)
  +getAvailableIndustryTypeNames()
  +createIndustry(dto)
}

class Repositories {
  -Repositories()
  +getInstance()
  +getMapRepository()
  +getIndustryRepository()
  +getIndustryTypeRepository()
}

class MapRepository {
  +getMaps()
}

class IndustryRepository {
  +createIndustry(dto)
  +createIndustry(industryType, xCoordinate, yCoordinate, mapSize)
  +addIndustry(industry)
}

class IndustryTypeRepository {
  +getIndustryTypes()
}

class MapListMapper {
  -toDTO(mapList)
  -toDTO(map)
}

class IndustryTypeListMapper {
  +toDTO(industryTypes>)
  +toDTO(industryType)
}

class IndustryListMapper {
  +toIndustry(dto):
}

class MapDTO {
  -size: int
  -name: String
  -scale: int
}

class IndustryTypeDTO {
  -importation: boolean
  -exportation: boolean
}

class IndustryDTO {
  -industryType: IndustryType
  -xCoordinate: int
  -yCoordinate: int
  -mapSize: int
  +getIndustryType()
  +getXCoordinate()
  +getYCoordinate()
  +getMapSize()
}

class Map {
  - size : int
  - name : String
  - scale : int
  - industries : List<Industry>
  - cities : List<City>
  +getMap(mapIndex)
  +addIndustry(industry)
}

class Industry {
  -industryType: IndustryType
  -position: Position
  +checkPosition(position, mapSize)
  +checkIndustryType(industryType)
}

 enum IndustryType{
    aluminum mill
    auto plant
    bakery
    bauxit mine
    cannery
    cattle yard
    chemical plant
    cement plant
    coal mine
    coffee farm
    cotton farm
    dairy farm
    dairy processor
    electric plant
    fertilizer plant
    grain silo
    gravel pit
    iron mine
    landfill
    logging camp
    lumber mill
    meat packing plant
    nuclear plant
    oil refinery
    oil well
    paper mill
    produce orchard
    rubber farm
    steel mill
    textile mill
    tire factory
    tool and die factory
    uranium mine
    geocore plant
    distillery
    munitions factory
    weapons factory
    port
    --
    -importation: ResourceType
    -exportation: ResourceType

  }

class Position {
  -xCoordinate: int
  -yCoordinate: int
  +createPosition(x, y)
}

' Associations
CreateIndustryUI ..> CreateIndustryController

CreateIndustryController ..> Repositories

Repositories -> "1" Repositories : instance
Repositories --> "1" MapRepository: mapRepository
Repositories --> "1" IndustryRepository: industryRepository
Repositories --> "1" IndustryTypeRepository: industryTypeRepository

CreateIndustryController ..> MapListMapper

MapListMapper --> "1" MapDTO

CreateIndustryController ..> IndustryTypeListMapper

IndustryTypeListMapper --> "1" IndustryTypeDTO

CreateIndustryController ..> IndustryListMapper

IndustryListMapper --> Industry

IndustryListMapper --> IndustryDTO

Industry --> "1" Position: position

IndustryTypeRepository --> "38" IndustryType: industryType
MapRepository --> "1..*" Map: map
IndustryType --> "1" Industry: industryType

IndustryRepository --> "*" Industry: industry
Map --> "*" Industry: industry

@enduml