@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

left to right direction

class Player {
    name
    password
    budget
}

class Map {
    size
    name
}

class Station {
    name
    capacity
    centre
}

class StationType{
    radius
    cost
}

class Building {
}

class BuildingType {
    upgrade
    cost
}

class Scenario {
    importation
    exportation
}

class Position{
    xCoordinate
    yCoordinate
}

class Cargo {
    quantity
}

class CargoStatus{
    supply
    demand
}

class ResourceType{
    value
}

class TimeRestriction{
    year
}

Player "1" -- "*" Station: builds >
Player "*" -- "1" Scenario : selects >
Map "1" -- "*" Station : contains >
Map "1" -- "*" Building: contains >
Scenario "*" -- "1" Map : uses >
Station "*" -- "1 "Building:  upgrades with  >
Station "1" -- "1" StationType: has >
Building "1" -- "1" BuildingType : has >
Position "1" -- "1" Station: has <
Station "1" -- "*" Cargo : stores >
Cargo "1" -- "1" ResourceType: has >
Cargo "1" -- "1" CargoStatus: has >
Scenario "1" -- "*" TimeRestriction: includes >
TimeRestriction "1" -- "*" BuildingType: affects >


@enduml