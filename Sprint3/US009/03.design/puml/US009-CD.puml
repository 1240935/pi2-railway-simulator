@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class BuyLocomotiveUI{
}

class BuyLocomotiveController {
  + BuyLocomotiveController()
  + getAvailableScenarios()
  + setScenario(scenario)
  + getAvailableScenarioDescriptions()
  + chooseScenarioByIndex(index)
  + getSelectedModel()
  + chooseModelByIndex(index)
  + getPlayer()
  + setPlayer(player)
  + getAvailableModelDescriptions()
  + getAvailableLocomotiveModels()
  + setModel(model)
  + createLocomotive()
}

class Repositories {
  + getInstance()
  + getScenarios()
  + getLocomotiveModels()
  + getLocomotives()
}

class ScenarioRepository {
  + getScenarios()
}

class LocomotiveModelRepository {
  + getLocomotiveModels()
}

class LocomotiveRepository {
  + nextID()
}

class Scenario {
       -map: Map
       -year: int
       -locomotiveTypes: List<LocomotiveType>
       -industryTypes: List<IndustryType>
       -importation: List<ResourceType>
       -exportation: List<ResourceType>
       -changers: List<IndustryChanger>
       +addLocomotive(locomotive)
 }

