@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

'hide footbox
actor "Player" as PLAYER
participant ":BuyLocomotiveUI" as UI
participant ":BuyLocomotiveController" as CTRL
participant "Repositories" as REPOS
participant "ScenarioRepository" as SCENARIO_REPO
participant "LocomotiveModelRepository" as LOC_REPO
participant "Scenario" as SCENARIO
participant "LocomotiveRepository" as LOCOMOTIVE_REPO
participant "Locomotive" as LOCOMOTIVE

activate PLAYER

    PLAYER -> UI : asks for the list of locomotives
    activate UI
        UI --> CTRL** : create()

        UI -> CTRL : getAvailableScenarioDescriptions()
        activate CTRL
            CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL : repositories
            deactivate REPOS

            CTRL -> SCENARIO_REPO : getScenarios()
            activate SCENARIO_REPO
                SCENARIO_REPO --> CTRL : list of scenarios
            deactivate SCENARIO_REPO

            CTRL --> UI : list of scenarios
        deactivate CTRL

        UI --> PLAYER : shows available scenarios
    deactivate UI

PLAYER -> UI : selects scenario
activate UI
    UI -> CTRL : chooseScenarioByIndex(index)
    activate CTRL
        CTRL --> UI : scenario selected
    deactivate CTRL

    UI -> CTRL : getAvailableLocomotiveModelDescriptions()
    activate CTRL
        CTRL -> REPOS : getInstance()
        activate REPOS
            REPOS --> CTRL: repositories
        deactivate REPOS

        CTRL -> LOC_REPO : getLocomotiveModels()
        activate LOC_REPO
            LOC_REPO --> CTRL : list of locomotives models
        deactivate LOC_REPO

        CTRL --> UI : list of locomotives
    deactivate CTRL

    UI --> PLAYER : shows the list of locomotive models
deactivate UI

PLAYER -> UI : selects locomotive model
activate UI
    UI -> CTRL : chooseModelByIndex(index)
    activate CTRL
    CTRL --> UI: selected model
    deactivate CTRL

    UI --> PLAYER: shows all data for confirmation

    deactivate UI
    PLAYER -> UI: confirms all data
    activate UI

    UI -> CTRL : createLocomotive()
    activate CTRL
    CTRL -> REPOS : getInstance()
            activate REPOS
                REPOS --> CTRL: repositories
            deactivate REPOS

            CTRL -> LOCOMOTIVE_REPO : getLocomotives()
            activate LOCOMOTIVE_REPO
                LOCOMOTIVE_REPO --> CTRL : list of locomotives
            deactivate LOCOMOTIVE_REPO
      CTRL -> LOCOMOTIVE_REPO : nextID()
            activate LOCOMOTIVE_REPO
                LOCOMOTIVE_REPO --> CTRL : iD
            deactivate LOCOMOTIVE_REPO
        CTRL -> LOCOMOTIVE** : create(model, iD)

        CTRL --> UI : locomotive
    deactivate CTRL

    UI --> PLAYER : operation success
deactivate UI

deactivate PLAYER

@enduml