@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    name
    size
}

class City {
    name
    positionX
    positionY
    houseBlocks
}

class Editor {
    username
    password
}

Map "1" -- "*" City : contains
Editor "1" -- "*" City : creates
Editor "1" -- "1..*" Map : creates

@enduml
