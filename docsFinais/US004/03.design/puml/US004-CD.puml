    @startuml
    'skinparam monochrome true
    skinparam packageStyle rectangle
    skinparam shadowing false
    skinparam linetype polyline
    'skinparam linetype orto

    skinparam classAttributeIconSize 0

    'left to right direction

    class CreateScenarioUI{
    }

    class CreateScenarioController {
        +CreateScenarioController()
        +getAvailableMaps()
        +getAvailableResourceType()
        +getAvailableIndustryTypes()
        +getAvailableLocomotiveTypes()
        +getAvailableLocomotiveTypeNames()
        +getAvailableMapNames()
        +getAvailableIndustryTypeNames()
        +getAvailableImpor_ExportationNames()
        +getAvailableIndustryChangerNames()
        +chooseMap(maps,choice)
        +chooseLocomotiveTypes
        +getExportation()
        +getImportation()
        +getChangers()
        +chooseIndustryTypes(types,choices)
        +chooseIndustryChanger(types,choices)
        +chooseImportation(types,choices)
        +chooseExportation(types,choices)
        +setMap(Map)
        +setYear(year)
        +getLocomotiveTypes()
        +setLocomotiveTypes(types)
        +getIndustryTypes()
        +setIndustryTypes(types)
        +setImportation(importation)
        +setExportation(exportation)
        +setChangers(changers)
        +readIntegerSelections(prompt)
        +createScenario()

    }

    class Repositories {
            -Repositories()
            +getInstance()
            +getMapRepository()
            +getLocomotiveTypeRepository()
            +getIndustryTypeRepository()
            +getIndustryChangerRepository()
    }

    class MapRepository {
            +getAvailableMaps()
        }

    class LocomotiveTypeRepository {
          +getLocomotiveTypes()
    }

    class IndustryTypeRepository {
          +getIndustryTypes()
    }

    class IndustryChangerRepository {
          +getIndustryChangers()
    }

     class Scenario {
       -map: Map
       -year: int
       -locomotiveTypes: List<LocomotiveType>
       -industryTypes: List<IndustryType>
       -importation: List<ResourceType>
       -exportation: List<ResourceType>
       -changers: List<IndustryChanger>
       +Scenario(map, year, locomotiveTypes, industryTypes, importation, exportation, changers)
     }

        class Map{
        - size : int
        - name : String
        - industries : List<Industry>
        - cities : List<City>
        }

        enum LocomotiveType{
            Steam
            Diesel
            Electric
        }

        enum IndustryType{
            aluminum mill
                auto plant
                bakery
                bauxit mine
                cannery
                cattle yard
                chemical plant
                cement plant
                coal mine
                coffee farm
                cotton farm
                dairy farm
                dairy processor
                electric plant
                fertilizer plant
                grain silo
                gravel pit
                iron mine
                landfill
                logging camp
                lumber mill
                meat packing plant
                nuclear plant
                oil refinery
                oil well
                paper mill
                produce orchard
                rubber farm
                steel mill
                textile mill
                tire factory
                tool and die factory
                uranium mine
                geocore plant
                distillery
                munitions factory
                weapons factory
                port
            --
            importation: ResourceType
            exportation: ResourceType
        }
     
        enum IndustryChanger{
            War
            Vaccination Campaign
            Schooling Program
            --
            -effect: int
        }


    CreateScenarioUI ..> CreateScenarioController

    CreateScenarioController ..> Scenario
    CreateScenarioController ..> Repositories

    Repositories -> "1" Repositories : instance
    Repositories --> "1" MapRepository: map repository
    Repositories --> "1" LocomotiveTypeRepository : locomotive type repository
    Repositories --> "1" IndustryTypeRepository : industry type repository
    Repositories --> "1" IndustryChangerRepository : industry changer repository

    MapRepository --> "*" Map : map
    LocomotiveTypeRepository --> "3" LocomotiveType : locomotive type
    IndustryTypeRepository --> "3" IndustryType : industry type
    IndustryChangerRepository --> "3" IndustryChanger : industry changer

    Scenario --> "1" Map : map
    Scenario --> "1..*" LocomotiveType: locomotive type
    Scenario --> "1..*" IndustryChanger : industry changer
    Scenario --> "1..*" IndustryType: industry type

    CreateScenarioController ..> Map
    CreateScenarioController ..> LocomotiveType
    CreateScenarioController ..> IndustryType
    CreateScenarioController ..> IndustryChanger


    @enduml