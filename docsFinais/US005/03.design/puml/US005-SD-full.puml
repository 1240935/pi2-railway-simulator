@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as PLAYER
participant ":BuildStationUI" as UI
participant ":BuildStationController" as CTRL
participant "Repositories" as REPOS
participant ":ScenarioRepository" as SCEN_REPO
participant "Scenario" as SCENARIO
participant ":CityRepository" as CITY_REPO
participant "City" as CITY
participant "StationType <<enumeration>>" as TYPE
participant "Position" as POSITION
participant "Station" as STATION


activate PLAYER

    PLAYER -> UI : asks to build a station
    activate UI

       UI --> CTRL** : create()

        UI -> CTRL : getAvailableScenarioDescriptions()
        activate CTRL

                CTRL -> REPOS : getInstance()
                activate REPOS

                REPOS --> CTRL: repositories

                deactivate REPOS

            CTRL -> SCEN_REPO : getScenarioRepository()
            activate SCEN_REPO

            SCEN_REPO --> CTRL : list of scenarios

            deactivate SCEN_REPO
        CTRL --> UI : list of scenarios
        deactivate CTRL

        UI --> PLAYER : shows the list of scenarios
    deactivate UI

    PLAYER -> UI : selects a scenario
    activate UI

        UI -> CTRL :setScenario(index)

        activate CTRL

        CTRL --> UI : scenario selected

        deactivate CTRL

         UI --> PLAYER :  asks for the XY coordinates
    deactivate UI


    PLAYER -> UI : types the XY coordinates
    activate UI

        UI -> CTRL : createPosition(xCoordinate, yCoordinate)
        activate CTRL
        CTRL -> POSITION **: createPosition(xCoordinate, yCoordinate)

        CTRL --> UI : position
        deactivate CTRL

        UI -> CTRL : checkCoordinates(xCoordinate, yCoordinate)

        activate CTRL

            CTRL -> SCENARIO : checkCoordinates(xCoordinate, yCoordinate)

            activate SCENARIO

            SCENARIO --> CTRL : valid coordinates

            deactivate SCENARIO

            CTRL --> UI: valid coordinates
            deactivate CTRL
            UI -> CTRL: getAvailableStationTypes()
            activate CTRL

            CTRL -> REPOS : getInstance()
                            activate REPOS

                            REPOS --> CTRL: repositories

                            deactivate REPOS

            CTRL -> TYPE : getAvailableStationTypes()
            activate TYPE
                TYPE --> CTRL : list of available station types
            deactivate TYPE
            CTRL --> UI : list of available station types
    deactivate CTRL



    UI --> PLAYER : shows list of station types

    deactivate UI

    PLAYER -> UI : selects a type from the available ones

    activate UI
        UI -> CTRL : setType(index)

        activate CTRL

        CTRL --> UI : selected type

        deactivate CTRL

        UI -> CTRL: determineStationCargoes(xCoordinate, yCoordinate)
        activate CTRL

        CTRL --> UI: list of cargo
        deactivate CTRL

    alt Depot or Terminal
        UI -> CTRL : setGeometricCenter()
        activate CTRL
        CTRL --> UI : center selected
        deactivate CTRL
    else Station
        UI --> PLAYER : asks for compass coordinate
        deactivate   UI

        PLAYER -> UI : types compass coordinate
        activate UI
        UI -> CTRL : setCompassCenter(compassCoord, xCoordinate, yCoordinate)

        activate CTRL

        CTRL --> UI : center


        deactivate CTRL

        end alt
        UI -> CTRL: getClosestCity(position)
        activate CTRL
        CTRL -> SCENARIO : getClosestCity(position)
                    activate SCENARIO
                    SCENARIO --> CTRL : city

                    deactivate SCENARIO
                    CTRL --> UI: city
                    deactivate CTRL
        UI -> CTRL: getName(city)
        activate CTRL


                                CTRL -> CITY : getName(city)

                                activate CITY

                                CITY --> CTRL : name

                                deactivate CITY

                                CTRL --> UI : name
                deactivate CTRL


        UI --> PLAYER : recommends a name based on the closest city
        deactivate UI

        alt recommended name
            PLAYER -> UI : selects recommended name
            activate UI
            UI -> CTRL : setName(name)
            activate CTRL
            CTRL --> UI : selected name
            deactivate CTRL
        else typed name
            PLAYER -> UI : types a different name

        UI -> CTRL : setName(name)

        activate CTRL
        CTRL --> UI : typed name
        deactivate CTRL

       end alt
    UI --> PLAYER : shows all data for confirmation
    deactivate UI
    PLAYER -> UI : confirms data
    activate UI

        UI -> CTRL : createStation(xCoordinate, yCoordinate)
        activate CTRL
            CTRL -> STATION **: create(position, name, type, center)

        CTRL --> UI : station
        deactivate CTRL

    UI --> PLAYER : displays success
    deactivate UI

deactivate PLAYER
@enduml
