@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Employee
participant "System" as System

activate Employee

    Employee -> System : asks to upgrade a station
    activate System

        System --> Employee : shows available stations
    deactivate System

    Employee -> System : selects a station
    activate System

        System --> Employee : receives the chosen station and \nshows available upgrades
    deactivate System

    Employee -> System : chooses the upgrade
    activate System

        System --> Employee : receives the chosen upgrade \n and shows all the data and cost of the upgrade
    deactivate System

    Employee -> System : accepts and pays the cost or denies the operation
    activate System

        System --> Employee : displays operation success and applies the \nupgrade on the chosen station
    deactivate System
@enduml