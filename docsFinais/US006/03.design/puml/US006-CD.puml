@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class UpgradeStationUI {
}

class UpgradeStationController {
    + UpgradeStationController()
    + getAvailableScenarios()
    + setScenario(scenario)
    + getAvailableStations()
    + setStation(station)
    + getAvailableScenarioNames()
    + getAvailableStationNames()
    + getAvailableBuildingNames()
    + getAvailableBuildingTypes()
    + setType(type)
    + setScenarioByIndex(index)
    + setStationByIndex(index)
    + setBuildingTypeByIndex(index)
    + getSelectedBuildingCost()
    + getPlayer()
    + setPlayer(player)
    + setBuilding(building)
    + createAndSetBuilding()
}

class ScenarioRepository {
    + getScenarios()
}

class StationRepository {
    + getStations()
}

class Repositories {
    - Repositories()
    + getInstance()
    + getScenarioRepository()
    + getStationRepository()
}

class BuildingTypeRepository{
    +getAvailableBuildingTypes()
}

enum BuildingType {
    Telegraph
    Telephone
    Small Café
    Large Café
    Customs
    Post office
    Small hotel
    Large hotel
    Silo
    Liquid Storage
    --
    upgrade : int
    cost : int
}

class Building {
    -type: BuildingType
    + Building(type)
}

class Station{
    -name : String
    -position : Position
    -type : StationType
    -center : StationCenter
    -building: Building
    -supply: List<Cargo>
    -demand: List<Cargo>
    +setBuilding(building)
}

class Scenario {
    -map: Map
    -year: int
    -locomotiveTypes: List<LocomotiveType>
    -industryTypes: List<IndustryType>
    -importation: List<ResourceType>
    -exportation: List<ResourceType>
    -changers: List<IndustryChanger>
}


UpgradeStationUI ..> UpgradeStationController

UpgradeStationController ..> Repositories
UpgradeStationController ..> ScenarioRepository
UpgradeStationController ..> StationRepository
UpgradeStationController ..> Building
UpgradeStationController ..> Scenario
UpgradeStationController ..> BuildingTypeRepository

ScenarioRepository --> "1..*" Scenario  : scenario
StationRepository --> "1..*" Station  : station

BuildingTypeRepository --> "1..*" BuildingType : building type
Scenario --> "*" Station : station
Station --> "*" Building : building

Repositories --> "1" ScenarioRepository : scenario repository
Repositories --> "1" Repositories : instance
Repositories --> "1" StationRepository : station repository
BuildingType --> "1" Building : building type


@enduml