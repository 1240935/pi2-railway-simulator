@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Station {
    name
    location
}

class Building {
    type
    capacity
}

class Cargo {
    type
    quantity
    demandSupplyType
}

class Player {
    username
    email
    password
}

Station "1" - "*" Building : contains
Station "1" - "*" Cargo : handles

Player "1" - "*" Station : lists

@enduml
