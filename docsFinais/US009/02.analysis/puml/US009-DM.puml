@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

class Locomotive {
    model
    speed
    capacity
    cost
}

class Player {
    name
    email
    balance
}

class Store {
    name
    location
}

Player "1" - "*" Locomotive : buys
Store "1" - "*" Locomotive : sells

Player "1" - "*" Store : purchases from


@enduml