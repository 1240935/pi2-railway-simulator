@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods


class Player {
    name
    password
}

class Train{
    type
    positionXY
    cost
    id
}

class Route {
    beginningStation
    stops
    finishStation

}

class Station {
    type
    positionXY
}

class Cargoes{
type
weight
value
}

Player -- Route : "1" creates
Player -- Cargoes : "1*" chooses
Player -- Train :"1" assigns
Route -- Station  :"2*" Lists
Train -- Route :"1" assigned to
Train -- Cargoes :"1*" assigned to
@enduml