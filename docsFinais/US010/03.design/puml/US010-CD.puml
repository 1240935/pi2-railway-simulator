@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline


class AssignRouteUI{
}

class AssignRouteController {
    +AssignRouteController()
  +getAvailableLocomotives()
  +getAvailableLocomotivesNames()
  +getAvailableScenarios()
  +getAvailableScenarioNames()
  +getAvailableStations()
  +getAvailableStationNames()
  +chooseScenario(List<Scenario>)
  +chooseLocomotive(List<Locomotive>)
  +chooseStation(List<Station>)
  +addStation(Station)
  +setFirstStation(Station)
  +setLastStation(Station)
  +getSupply()
  +getSupplyDisplayList()
  +selectCargoByIndex(index)
  +setSelectedLocomotive(Locomotive)
  +setSelectedScenario(Scenario)
  +createRoute()
  +createRoute2()
}

class Scenario {
  -map: Map
           -year: int
           -locomotiveTypes: List<LocomotiveType>
           -industryTypes: List<IndustryType>
           -importation: List<ResourceType>
           -exportation: List<ResourceType>
           -changers: List<IndustryChanger>
  +getLocomotives()
  +getStations()
  +addRoute(Route)
}

class Route {
  - startingStation: Station
    - endingStation: Station
    - stops: List<Station>
    - locomotive: Locomotive
    - cargos: List <Cargos>
  +setStops(List<Station>)
  +createRoute(
}

class Station {
  - name: String
    - center: StationCenter
    - position: Position
    - type: StationType
    - building: BuildingType
    - demands: List<Cargo>
    - supplies: List<Cargo>
  +getSuppliesOnly(List<Industry>, List<City>)
  +toString()
}

class Locomotive {
    - iD: int
    - model: LocomotiveModel
  +toString()
}

class Cargo {
  - type: ResourceType
  - quantity : int
  +getType()
}

class Map {
  - size : int
  - name : String
  - industries : List<Industry>
  - cities : List<City>
  +getIndustries()
  +getCities()
}

class Repositories {
  +getInstance()
  +getScenarioRepository()
  +getRouteRepository()
}

class ScenarioRepository {
  +getScenarios()
}

class RouteRepository {
  +addRoute(Route)
}

AssignRouteUI ..> AssignRouteController

AssignRouteController ..> Scenario
AssignRouteController ..> Station
AssignRouteController ..> Route
AssignRouteController ..> Locomotive
AssignRouteController ..> Cargo
AssignRouteController ..> Repositories

Scenario --> "1..*" Map: map
Scenario --> "1..*" Locomotive: locomotive
Scenario --> "1..*" Station: station
Scenario --> "1..*" Route: route

Cargo --> "1" CargoType: cargo type

Repositories -> "1" Repositories : instance
Repositories --> ScenarioRepository: scenario repository
Repositories --> RouteRepository: route repository

ScenarioRepository --> "*" Scenario: scenario
RouteRepository --> "*" Route: route
@enduml
