@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
'skinparam linetype ortho
'left to right direction
skinparam classAttributeIconSize 0
hide circle
hide methods

left to right direction

class Player {
    username
    password
    budget
}

class Editor {
    username
    password
}

class Map {
    name
    size
}

class Station {
    type
    positionXY
    centre
    name
    cost
    capacity
    radius
}

class Building {
    type
    cost
    upgrade
}

class Cargo {
    type
    quantity
    availability
}

class Industry {
    type
    positionXY
    resourceType
    resourceGeneration
}

class Scenario {
    timeRestriction
    portsCargoes
    portsBehaviour
    locomotiveTypes
    industriesTypes
    locomotionTypes
    industryChangers
}

class City {
    name
    positionXY
    houseBlocks
    blocksXYPosition
    people
    mail
    finalProduct
}

class Railway{
    length
    size
    cost
    type
}

class Cargo {
    type
    quantity
    status
}

class Locomotive {
    type
    power
    acceleration
    topSpeed
    operationStartYear
    fuelCost
    maintenancePYear
    cost
    ID
}

class Route {
    beginningStation
    stops
    finishStation
}

class Simulator{
    status
}

class ProductOwner {
    name
    password
}

Editor "1" -- "*" Map : creates >
Editor "1" -- "1" Scenario : creates >
Scenario "*" -- "1" Map : uses >
Map "1" -- "*" Station : contains >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
Station "1" -- "*" Building : upgrades with >
Station "1" -- "*" Cargo : manages >
Station "1..*" -- "2..*" Railway : connects <
Player "1" -- "1" Scenario : selects >
Player "1" -- "*" Station : builds >
Player "1" - "*" Route : creates >
Player "1" -- "*"  Cargo : selects >
Player "1" -- "1..*" Locomotive : buys >
Locomotive "1..*" -- "*" Route : assigned to >
Locomotive "1..*" -- "1..*" Cargo : transports >
Railway "1..*" -- "1" Route: uses <
City "1..*" -- "2..*" Railway : connects <
Industry "1..*" -- "2..*" Railway : connects <
Scenario "1" -- "*" Locomotive: conditions >
ProductOwner "1" -- "1" Simulator: controls >
Simulator "1" -- "*" Cargo: generates >
Simulator "1" -- "*" City: considers >
Simulator "1" -- "*" Industry: considers >
Simulator "1" -- "*" Station: considers >


@enduml