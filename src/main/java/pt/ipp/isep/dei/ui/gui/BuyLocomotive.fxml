<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.ipp.isep.dei.ui.gui.BuyLocomotiveGUI"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Select Scenario:" />
    <ComboBox fx:id="scenarioComboBox" prefWidth="300" />

    <Label text="Select Locomotive Model:" />
    <ComboBox fx:id="modelComboBox" prefWidth="300" />

    <Label fx:id="budgetLabel" text="Player budget: -" />
    <Label fx:id="costLabel" text="Locomotive cost: -" />

    <Button fx:id="buyButton" text="Buy Locomotive" maxWidth="150" />

</VBox>
